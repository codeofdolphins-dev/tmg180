# Copy to .env — .env is gitignored, never commit real secrets.
NODE_ENV=development
PORT=4000

# Postgres. Prisma reads this via prisma.config.ts.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tmg180?schema=public"

# Access tokens are JWTs — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me
ACCESS_TOKEN_TTL=15m

# How long a device stays signed in without re-entering a password. Refresh
# tokens are opaque and stored hashed in tmg_refresh_tokens, so they need no
# signing secret — the row is the authority and revoking it ends the session.
REFRESH_TOKEN_TTL=30d

# Where password-reset links point — the web app, not the API.
APP_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=60

# Email transport. Unset in development: reset links are written to the server
# log instead. Unset in production is a hard failure — see services/mailer.ts.
# SMTP_URL=

# Comma-separated browser origins. Mobile sends no Origin and is unaffected.
CORS_ORIGINS=http://localhost:5173

# Platform Governance (admin) account created by `pnpm db:seed`. Admin is never
# self-served — it is provisioned. The dev defaults (admin@tmg180.test /
# Governance1!) are refused in production, so set both there.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=
