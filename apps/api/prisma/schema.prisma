// Net-new `tmg_*` tables, from md/TMG180_New_Database_Tables.md.
// Not expressible here, must go in migration SQL by hand: the
// intensity_rating 0-4 CHECK, the consent_revocation_trigger, the banned-term seed.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// SECTION 0: ACCOUNTS
// ============================================================
// Not in the DB pack — it assumes an existing users table and leaves every
// participant_id/worker_id an unconstrained INTEGER. One table for all three
// actors: `roles` is an array because an account can hold more than one
// workspace, while the *_role columns below record which one it acted as.

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  password_hash String?   @db.VarChar(255)
  full_name     String    @db.VarChar(255)
  roles         String[]  @db.VarChar(50)
  status        String    @default("active") @db.VarChar(50)
  ndis_number   String?   @db.VarChar(50)
  last_login_at DateTime? @db.Timestamptz
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz

  profile                  ParticipantProfile?        @relation("ParticipantProfile")
  intakes                  FcaIntake[]                @relation("ParticipantIntakes")
  goals                    ParticipantGoal[]          @relation("ParticipantGoals")
  checkins                 ParticipantCheckin[]       @relation("ParticipantCheckins")
  snapshots                MonthlySnapshot[]          @relation("ParticipantSnapshots")
  private_notes_authored   DailyNotePrivate[]         @relation("WorkerPrivateNotes")
  private_notes_about      DailyNotePrivate[]         @relation("ParticipantPrivateNotes")
  notes_authored           DailyNoteStructured[]      @relation("WorkerNotes")
  notes_about              DailyNoteStructured[]      @relation("ParticipantNotes")
  note_addenda             DailyNoteAddendum[]        @relation("NoteAddenda")
  snapshot_addenda         SnapshotAddendum[]         @relation("SnapshotAddenda")
  consents_given           Consent[]                  @relation("ParticipantConsents")
  consents_held            Consent[]                  @relation("WorkerConsents")
  invitations_sent         ExternalWorkerInvitation[] @relation("ParticipantInvitations")
  invitations_revoked      ExternalWorkerInvitation[] @relation("InvitationRevocations")
  external_notes           ExternalSupportNote[]      @relation("ParticipantExternalNotes")
  invoices_raised          Invoice[]                  @relation("WorkerInvoices")
  invoices_received        Invoice[]                  @relation("ParticipantInvoices")
  invoice_audit_entries    InvoiceAudit[]             @relation("InvoiceAuditChanges")
  notifications            Notification[]             @relation("UserNotifications")
  audit_entries            AuditLog[]                 @relation("AuditActor")
  deletion_requests        DeletionRequest[]          @relation("ParticipantDeletionRequests")
  deletion_requests_closed DeletionRequest[]          @relation("DeletionRequestsProcessed")

  @@index([status])
  @@index([roles(ops: ArrayOps)], type: Gin)
  @@map("tmg_users")
}

// ============================================================
// SECTION 1: TERMINOLOGY AND LANGUAGE ENFORCEMENT
// ============================================================

model TerminologyRegistry {
  id         Int      @id @default(autoincrement())
  key        String   @unique @db.VarChar(255)
  value      String
  context    String?  @db.VarChar(100)
  notes      String?
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  @@index([context])
  @@map("tmg_terminology_registry")
}

model BannedTerm {
  id          Int      @id @default(autoincrement())
  banned_term String   @unique @db.VarChar(255)
  replacement String   @db.VarChar(255)
  context     String?
  created_at  DateTime @default(now()) @db.Timestamptz

  @@map("tmg_banned_terms")
}

model ImprovementMarker {
  id          Int      @id @default(autoincrement())
  marker_type String   @db.VarChar(100)
  marker_text String
  domain_tag  String?  @db.VarChar(50)
  created_at  DateTime @default(now()) @db.Timestamptz

  @@map("tmg_improvement_markers")
}

model SupportBanding {
  id                   Int      @id @default(autoincrement())
  band_code            String   @unique @db.VarChar(50)
  band_label           String
  description          String?
  min_frequency        Int?
  max_frequency        Int?
  intensity_range_low  Int?
  intensity_range_high Int?
  created_at           DateTime @default(now()) @db.Timestamptz

  @@map("tmg_support_banding")
}

model TranslatorTerm {
  id                Int      @id @default(autoincrement())
  ndis_term         String   @db.VarChar(255)
  relational_term   String   @db.VarChar(255)
  functional_domain String?  @db.VarChar(100)
  context           String?
  created_at        DateTime @default(now()) @db.Timestamptz

  @@map("tmg_translator_terms")
}

// ============================================================
// SECTION 1B: PARTICIPANT PERSONAL PROFILE (Final Override P1-01..03)
// ============================================================
// Not in the DB pack — the pack only has the flat tmg_fca_intake row below.
// These three tables are the Final Override's participant_profiles /
// _sections / _answers: the profile is a living, resumable, participant-owned
// document, distinct from the versioned FCA evidence artifact. Section and
// question definitions live in @tmg180/shared (packages/shared/src/profile.js),
// not here — answers are (question_key -> JSONB) rows, so section/question
// changes are seed edits, never migrations. Section list follows the built UI
// (Figma 29 July); ruling R-01 may swap two sections later.

model ParticipantProfile {
  id                 Int      @id @default(autoincrement())
  participant_id     Int      @unique
  status             String   @default("in_progress") @db.VarChar(50)
  /// P1-01: "continue where I left off" — the last section saved.
  last_section_key   String?  @db.VarChar(100)
  completed_sections Int      @default(0)
  total_sections     Int      @default(11)
  created_at         DateTime @default(now()) @db.Timestamptz
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz

  participant User                        @relation("ParticipantProfile", fields: [participant_id], references: [id])
  sections    ParticipantProfileSection[]

  @@map("tmg_participant_profiles")
}

model ParticipantProfileSection {
  id           Int       @id @default(autoincrement())
  profile_id   Int
  section_key  String    @db.VarChar(100)
  /// not_started | in_progress | complete. Complete is sticky: once set it is
  /// never demoted, even if a required answer is later cleared.
  status       String    @default("not_started") @db.VarChar(50)
  completed_at DateTime? @db.Timestamptz
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz

  profile ParticipantProfile         @relation(fields: [profile_id], references: [id])
  answers ParticipantProfileAnswer[]

  @@unique([profile_id, section_key])
  @@map("tmg_participant_profile_sections")
}

model ParticipantProfileAnswer {
  id           Int      @id @default(autoincrement())
  section_id   Int
  question_key String   @db.VarChar(100)
  /// Typed by the question definition in @tmg180/shared, enforced by the API:
  /// string | string[] | boolean | int | [{text, done}].
  value        Json
  /// P1-03: participant_private | share_with_consent | snapshot_only.
  visibility   String   @default("participant_private") @db.VarChar(50)
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz

  section ParticipantProfileSection @relation(fields: [section_id], references: [id])

  @@unique([section_id, question_key])
  @@map("tmg_participant_profile_answers")
}

// ============================================================
// SECTION 2: PARTICIPANT EVIDENCE ARCHITECTURE
// ============================================================

model FcaIntake {
  id             Int       @id @default(autoincrement())
  participant_id Int
  version        Int       @default(1)
  status         String?   @default("draft") @db.VarChar(50)
  submitted_at   DateTime? @db.Timestamptz

  personality_tags String[]
  meaning_tags     String[]

  strengths_tags String[]
  goals_tags     String[]

  mobility_tags        String[]
  mobility_notes       String?
  communication_tags   String[]
  communication_notes  String?
  social_tags          String[]
  social_notes         String?
  selfcare_tags        String[]
  selfcare_notes       String?
  learning_tags        String[]
  learning_notes       String?
  selfmanagement_tags  String[]
  selfmanagement_notes String?

  community_tags String[]
  health_tags    String[]
  equipment_tags String[]

  support_pattern_tags String[]
  fluctuation_notes    String?

  safety_tags    String[]
  safety_notes   String?
  substance_tags String[]

  compat_style_tags    String[]
  compat_gender_tags   String[]
  compat_faith_tags    String[]
  compat_identity_tags String[]
  compat_avoid_tags    String[]

  documentation_consent String[]
  consent_declared      Boolean?  @default(false)
  consent_declared_at   DateTime? @db.Timestamptz

  ndis_goals                     Json?
  impairment_categories          String[]
  notice_of_impairments_uploaded Boolean? @default(false)

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  participant User              @relation("ParticipantIntakes", fields: [participant_id], references: [id])
  goals       ParticipantGoal[]

  @@index([participant_id])
  @@index([status])
  @@map("tmg_fca_intake")
}

model ParticipantGoal {
  id                Int      @id @default(autoincrement())
  participant_id    Int
  intake_id         Int?
  goal_text         String
  ndis_domain       String?  @db.VarChar(100)
  ndis_domain_label String?
  goal_order        Int?     @default(1)
  is_active         Boolean? @default(true)
  created_at        DateTime @default(now()) @db.Timestamptz

  participant User       @relation("ParticipantGoals", fields: [participant_id], references: [id])
  intake      FcaIntake? @relation(fields: [intake_id], references: [id])

  @@index([participant_id])
  @@index([participant_id, is_active])
  @@map("tmg_participant_goals")
}

model DailyNotePrivate {
  id                Int       @id @default(autoincrement())
  worker_id         Int
  participant_id    Int
  session_date      DateTime  @db.Date
  start_time        DateTime? @db.Time
  end_time          DateTime? @db.Time
  duration_minutes  Int?
  service_type      String?   @db.VarChar(100)
  location          String?   @db.VarChar(255)
  private_narrative String?
  safety_narrative  String?
  created_at        DateTime  @default(now()) @db.Timestamptz
  is_locked         Boolean?  @default(true)

  worker           User                  @relation("WorkerPrivateNotes", fields: [worker_id], references: [id])
  participant      User                  @relation("ParticipantPrivateNotes", fields: [participant_id], references: [id])
  structured_notes DailyNoteStructured[]

  @@index([worker_id, session_date])
  @@map("tmg_daily_note_private")
}

model DailyNoteStructured {
  id               Int      @id @default(autoincrement())
  private_note_id  Int?
  worker_id        Int
  participant_id   Int
  session_date     DateTime @db.Date
  duration_minutes Int?
  service_type     String?  @db.VarChar(100)
  location         String?  @db.VarChar(255)

  goal_ids       Int[]
  goal_validated Boolean? @default(false)

  domain_tags      String[] @db.VarChar(50)
  domain_validated Boolean? @default(false)

  impact_tags       String[]
  support_type_tags String[]

  outcome_tags String[]
  outcome_text String?

  baseline_comparison String?  @db.VarChar(50)
  baseline_factors    String[]
  baseline_notes      String?

  participant_voice String?
  safety_note       String?

  status       String?  @default("submitted") @db.VarChar(50)
  submitted_at DateTime @default(now()) @db.Timestamptz
  is_locked    Boolean? @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz

  worker       User                @relation("WorkerNotes", fields: [worker_id], references: [id])
  participant  User                @relation("ParticipantNotes", fields: [participant_id], references: [id])
  private_note DailyNotePrivate?   @relation(fields: [private_note_id], references: [id])
  addenda      DailyNoteAddendum[]
  invoices     Invoice[]

  @@index([participant_id, session_date])
  @@index([worker_id, session_date])
  @@map("tmg_daily_note_structured")
}

model DailyNoteAddendum {
  id            Int      @id @default(autoincrement())
  note_id       Int?
  added_by      Int
  added_by_role String   @db.VarChar(50)
  addendum_text String
  created_at    DateTime @default(now()) @db.Timestamptz

  author User                 @relation("NoteAddenda", fields: [added_by], references: [id])
  note   DailyNoteStructured? @relation(fields: [note_id], references: [id])

  @@map("tmg_daily_note_addendum")
}

model ParticipantCheckin {
  id             Int      @id @default(autoincrement())
  participant_id Int
  checkin_period String?  @db.VarChar(50)
  checkin_date   DateTime @db.Date

  impact_tags  String[]
  impact_notes String?

  intensity_rating Int?

  helped_tags  String[]
  helped_notes String?

  recovery_level String? @db.VarChar(100)
  recovery_notes String?

  goals_checkin_tags String[]
  goals_notes        String?

  own_words String?

  created_at DateTime @default(now()) @db.Timestamptz
  is_locked  Boolean? @default(true)

  participant User @relation("ParticipantCheckins", fields: [participant_id], references: [id])

  @@index([participant_id, checkin_date])
  @@map("tmg_participant_checkin")
}

model MonthlySnapshot {
  id             Int    @id @default(autoincrement())
  participant_id Int
  month_year     String @db.VarChar(7)
  version        Int?   @default(1)

  generated_from_notes    Int[]
  generated_from_checkins Int[]
  generated_at            DateTime? @db.Timestamptz

  participant_story     String?
  what_mattered         String?
  what_got_in_way       String?
  what_helped           String?
  recovery_cost         String?
  next_month_intentions String?

  participation_domains    String[]
  main_functional_impacts  String?
  frequency_pattern        String?
  recovery_cost_trend      String?
  supports_that_helped     String?
  when_support_unavailable String?

  mobility_summary       String?
  communication_summary  String?
  social_summary         String?
  selfcare_summary       String?
  learning_summary       String?
  selfmanagement_summary String?

  impairment_category String?
  impairment_linkage  String?
  goal_linkage        String?

  outcome_tags       String[]
  outcome_highlights String?

  nonlinear_statement String @default("Capacity varied across the month, consistent with non-linear functioning. Participation improved with support scaffolding. This reflects supports working, not removal of impairment.")

  status                  String?   @default("draft") @db.VarChar(50)
  participant_approved    Boolean?  @default(false)
  participant_approved_at DateTime? @db.Timestamptz
  participant_addendum    String?
  locked_at               DateTime? @db.Timestamptz

  exported_at   DateTime? @db.Timestamptz
  export_format String?   @db.VarChar(50)

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  participant User               @relation("ParticipantSnapshots", fields: [participant_id], references: [id])
  addenda     SnapshotAddendum[]

  @@unique([participant_id, month_year, version], map: "idx_snapshot_unique")
  @@index([participant_id, month_year])
  @@map("tmg_monthly_snapshot")
}

model SnapshotAddendum {
  id            Int      @id @default(autoincrement())
  snapshot_id   Int?
  added_by      Int
  added_by_role String   @db.VarChar(50)
  addendum_text String
  created_at    DateTime @default(now()) @db.Timestamptz

  author   User             @relation("SnapshotAddenda", fields: [added_by], references: [id])
  snapshot MonthlySnapshot? @relation(fields: [snapshot_id], references: [id])

  @@map("tmg_snapshot_addendum")
}

// ============================================================
// SECTION 3: CONSENT ARCHITECTURE
// ============================================================

model Consent {
  id             Int       @id @default(autoincrement())
  participant_id Int
  worker_id      Int?
  consent_type   String    @db.VarChar(100)
  status         String    @db.VarChar(50)
  granted_at     DateTime? @db.Timestamptz
  revoked_at     DateTime? @db.Timestamptz
  revoked_reason String?

  can_view_intake    Boolean? @default(false)
  can_view_snapshot  Boolean? @default(false)
  can_add_daily_note Boolean? @default(false)
  can_view_checkins  Boolean? @default(false)

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  superseded_by Int?

  participant  User      @relation("ParticipantConsents", fields: [participant_id], references: [id])
  worker       User?     @relation("WorkerConsents", fields: [worker_id], references: [id])
  successor    Consent?  @relation("ConsentSupersession", fields: [superseded_by], references: [id])
  predecessors Consent[] @relation("ConsentSupersession")

  @@index([participant_id, status])
  @@index([worker_id, status])
  @@map("tmg_consent")
}

// ============================================================
// SECTION 4: EXTERNAL WORKER ACCESS LAYER (Layer D)
// ============================================================

model ExternalWorkerInvitation {
  id             Int     @id @default(autoincrement())
  participant_id Int
  worker_name    String  @db.VarChar(255)
  worker_email   String  @db.VarChar(255)
  worker_role    String? @db.VarChar(255)
  token_hash     String  @unique @db.VarChar(255)
  status         String? @default("pending") @db.VarChar(50)

  created_at  DateTime  @default(now()) @db.Timestamptz
  expires_at  DateTime? @default(dbgenerated("(now() + '72:00:00'::interval)")) @db.Timestamptz
  accepted_at DateTime? @db.Timestamptz
  revoked_at  DateTime? @db.Timestamptz
  revoked_by  Int?

  note_submitted    Boolean?  @default(false)
  note_submitted_at DateTime? @db.Timestamptz

  participant User                  @relation("ParticipantInvitations", fields: [participant_id], references: [id])
  revoker     User?                 @relation("InvitationRevocations", fields: [revoked_by], references: [id])
  notes       ExternalSupportNote[]

  @@index([participant_id])
  @@index([token_hash])
  @@index([status])
  @@map("tmg_external_worker_invitations")
}

model ExternalSupportNote {
  id                   Int    @id @default(autoincrement())
  invitation_id        Int?
  participant_id       Int
  external_worker_name String @db.VarChar(255)
  external_worker_role String @db.VarChar(255)

  session_date      DateTime @db.Date
  duration_minutes  Int?
  support_type_tags String[]
  presentation_tags String[]
  outcome_text      String?
  safety_note       String?

  status                  String?   @default("pending_review") @db.VarChar(50)
  participant_reviewed_at DateTime? @db.Timestamptz
  participant_approved    Boolean?
  rejection_reason        String?

  submitted_at DateTime @default(now()) @db.Timestamptz
  is_locked    Boolean? @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz

  participant User                      @relation("ParticipantExternalNotes", fields: [participant_id], references: [id])
  invitation  ExternalWorkerInvitation? @relation(fields: [invitation_id], references: [id])

  @@index([participant_id, session_date])
  @@index([participant_id, status])
  @@map("tmg_external_support_notes")
}

// ============================================================
// SECTION 5: INVOICE AND PAYMENT WORKFLOW
// ============================================================

model Invoice {
  id             Int @id @default(autoincrement())
  worker_id      Int
  participant_id Int

  daily_note_id    Int?
  service_date     DateTime @db.Date
  duration_minutes Int

  support_item_number String?  @db.VarChar(50)
  support_item_name   String?
  support_category    String?  @db.VarChar(100)
  unit_price          Decimal? @db.Decimal(10, 2)
  quantity            Decimal? @db.Decimal(10, 2)
  gst_applicable      Boolean? @default(false)
  total_amount        Decimal? @db.Decimal(10, 2)

  plan_manager_name       String? @db.VarChar(255)
  plan_manager_email      String? @db.VarChar(255)
  participant_ndis_number String? @db.VarChar(50)

  status           String?   @default("draft") @db.VarChar(50)
  submitted_at     DateTime? @db.Timestamptz
  approved_at      DateTime? @db.Timestamptz
  paid_at          DateTime? @db.Timestamptz
  rejected_at      DateTime? @db.Timestamptz
  rejection_reason String?

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  worker      User                 @relation("WorkerInvoices", fields: [worker_id], references: [id])
  participant User                 @relation("ParticipantInvoices", fields: [participant_id], references: [id])
  daily_note  DailyNoteStructured? @relation(fields: [daily_note_id], references: [id])
  audit_log   InvoiceAudit[]

  @@index([worker_id, service_date])
  @@index([participant_id])
  @@index([status])
  @@map("tmg_invoices")
}

model InvoiceAudit {
  id              Int      @id @default(autoincrement())
  invoice_id      Int?
  previous_status String?  @db.VarChar(50)
  new_status      String?  @db.VarChar(50)
  changed_by      Int?
  changed_by_role String?  @db.VarChar(50)
  notes           String?
  created_at      DateTime @default(now()) @db.Timestamptz

  changer User?    @relation("InvoiceAuditChanges", fields: [changed_by], references: [id])
  invoice Invoice? @relation(fields: [invoice_id], references: [id])

  @@map("tmg_invoice_audit")
}

// ============================================================
// SECTION 6: NOTIFICATION SYSTEM
// ============================================================

model Notification {
  id                Int     @id @default(autoincrement())
  recipient_id      Int
  recipient_role    String  @db.VarChar(50)
  notification_type String  @db.VarChar(100)
  title             String
  body              String
  reference_id      Int?
  reference_type    String? @db.VarChar(100)

  is_read    Boolean?  @default(false)
  read_at    DateTime? @db.Timestamptz
  created_at DateTime  @default(now()) @db.Timestamptz

  recipient User @relation("UserNotifications", fields: [recipient_id], references: [id])

  @@index([recipient_id, recipient_role, is_read])
  @@index([notification_type, created_at])
  @@map("tmg_notifications")
}

// ============================================================
// SECTION 7: DATA RETENTION AND AUDIT
// ============================================================

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actor_id    Int?
  actor_role  String?  @db.VarChar(50)
  action      String   @db.VarChar(100)
  target_type String?  @db.VarChar(100)
  target_id   Int?
  details     Json?
  ip_address  String?  @db.Inet
  created_at  DateTime @default(now()) @db.Timestamptz

  actor User? @relation("AuditActor", fields: [actor_id], references: [id])

  @@index([actor_id, created_at])
  @@index([target_type, target_id, created_at])
  @@index([action, created_at])
  @@map("tmg_audit_log")
}

model DeletionRequest {
  id                Int       @id @default(autoincrement())
  participant_id    Int
  requested_at      DateTime  @default(now()) @db.Timestamptz
  status            String?   @default("pending") @db.VarChar(50)
  legal_hold        Boolean?  @default(false)
  legal_hold_reason String?
  processed_at      DateTime? @db.Timestamptz
  processed_by      Int?
  notes             String?

  participant User  @relation("ParticipantDeletionRequests", fields: [participant_id], references: [id])
  processor   User? @relation("DeletionRequestsProcessed", fields: [processed_by], references: [id])

  @@map("tmg_deletion_requests")
}
