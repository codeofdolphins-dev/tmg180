# Copy to .env — .env is gitignored.
#
# Auth always talks to the API (apps/api must be running against a migrated
# database). There is no mock backend: a screen that looks signed in without a
# server session is worse than one that fails loudly.

# Only needed when web and API are on different origins. In dev the Vite proxy
# forwards /api to http://localhost:4000, so leave this unset.
# VITE_API_URL=https://api.example.com

# Override the dev proxy target if the API runs on another port.
# VITE_API_PROXY=http://localhost:4000
